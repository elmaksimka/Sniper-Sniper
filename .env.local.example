ENVIRONMENT=development
APP_VERSION=0.1.0
GIT_SHA=local

POSTGRES_USER=alpha
POSTGRES_PASSWORD=alpha-local-only
POSTGRES_DB=alpha_engine
DATABASE_URL=postgresql+asyncpg://alpha:alpha-local-only@postgres:5432/alpha_engine

SOLANA_RPC_URL=https://api.mainnet.solana.com
TRANSACTION_HISTORY_MODE=standard
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_TIMEOUT_SECONDS=15
HELIUS_MAX_RETRIES=4
HELIUS_RETRY_BASE_SECONDS=1
HELIUS_RETRY_MAX_SECONDS=30
HELIUS_MAX_CONCURRENCY=2

MONITOR_POLL_INTERVAL_SECONDS=300
MONITOR_PAGE_SIZE=20
MONITOR_MAX_PAGES=3
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_STALE_SECONDS=360
READINESS_CHECK_TIMEOUT_SECONDS=10

ADMIN_API_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
