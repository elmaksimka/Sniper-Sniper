ENVIRONMENT=production

POSTGRES_USER=alpha
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=alpha_engine
DATABASE_URL=postgresql+asyncpg://alpha:replace-with-a-strong-password@postgres:5432/alpha_engine

HELIUS_API_KEY=replace-with-a-helius-api-key
HELIUS_RPC_URL=

API_PORT=8000
IMAGE_TAG=latest

MONITOR_POLL_INTERVAL_SECONDS=30
MONITOR_PAGE_SIZE=100
MONITOR_MAX_PAGES=10
WORKER_LEADER_LOCK_KEY=712493551
WORKER_STANDBY_POLL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_STALE_SECONDS=120
READINESS_CHECK_TIMEOUT_SECONDS=3

HELIUS_TIMEOUT_SECONDS=10
HELIUS_MAX_RETRIES=3
HELIUS_RETRY_BASE_SECONDS=0.5
HELIUS_RETRY_MAX_SECONDS=10
HELIUS_MAX_CONCURRENCY=5
